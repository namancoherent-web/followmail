# CoherentConnect Newsletter — API keys
# The app also auto-reads ../sales-agent-draft-/.env if present, so you can leave this
# empty when running next to the mother repo.

DEEPSEEK_API_KEY=your-deepseek-api-key-here      # primary provider (OpenAI-compatible)
         # fallback provider

# Which provider to try first: deepseek | openai  (default: deepseek)
LLM_PROVIDER=deepseek
